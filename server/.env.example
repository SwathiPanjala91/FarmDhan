# FarmDhan Backend Environment Variables
PORT=5000

# MongoDB Connection (Leave as is for local or provide MongoDB Atlas URI: mongodb+srv://<user>:<password>@cluster.mongodb.net/farmdhan)
MONGODB_URI=mongodb://127.0.0.1:27017/farmdhan

# JWT Secret for authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Set to true to automatically use in-memory MongoDB fallback if local mongod is not running
USE_MEMORY_DB_FALLBACK=true

NODE_ENV=development
