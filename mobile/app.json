{
  "expo": {
    "name": "FarmDhan",
    "slug": "farmdhan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#2E7D32"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2E7D32"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "package": "com.anonymous.farmdhan",
      "usesCleartextTraffic": true
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow FarmDhan to use the microphone for voice queries.",
          "speechRecognitionPermission": "Allow FarmDhan to recognize your voice in Telugu, Hindi, and English."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
