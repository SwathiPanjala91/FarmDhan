        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "package": "com.anonymous.farmdhan"
    },
    "web": {
